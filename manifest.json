{
  "manifest_version": 3,
  "name": "Gmail Weather Companion",
  "version": "1.1.1",
  "description": "Live weather forecasts, interactive Doppler radar, destination search, and smart packing recommendations directly inside Gmail.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "css": ["leaflet.css", "styles.css"],
      "js": ["leaflet.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.rainviewer.com/*",
    "https://tilecache.rainviewer.com/*",
    "https://*.basemaps.cartocdn.com/*"
  ]
}
